# Alpaca API credentials — https://alpaca.markets/dashboard
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# TradersPost webhook URL — create one at https://traderspost.io
TRADERSPOST_STOCKS_WEBHOOK_URL=https://traderspost.io/trading/webhook/your-webhook-id

# Data feed: iex (free tier) or sip (requires subscription)
ALPACA_DATA_FEED=iex

# Gmail reporting (use an App Password, not your account password)
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
MY_EMAIL=where_to_send_reports@example.com

# ===========================================================================
# F3 Strategy (Claude Trader) — the 7-agent ICT system in f3/
# ===========================================================================
# Claude is the CEO that signs off every trade. Without a key, a deterministic
# consensus stands in (same hard veto rules), so this is optional.
ANTHROPIC_API_KEY=sk-ant-...

# Auto-execution. Leave F3_EXECUTE=0 (dry-run/log-only) while validating; set to
# 1 and provide a broker webhook (e.g. TradersPost futures) to place trades
# automatically — you never lift a finger.
F3_EXECUTE=0
F3_WEBHOOK_URL=https://traderspost.io/trading/webhook/your-futures-webhook-id

# Account size used for the 0.5%-per-trade position sizing.
F3_ACCOUNT_BALANCE=50000

# Comma-separated high-impact events scheduled today → Lumen enforces a blackout.
# e.g. F3_NEWS_TODAY=CPI  (leave empty on normal days)
F3_NEWS_TODAY=

# Optional: directory of <market>.csv OHLC files for your live feed (NQ.csv, GC.csv).
# Leave empty to use the built-in synthetic series for dry-runs.
F3_DATA_DIR=
