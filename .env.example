# Alpaca API credentials — https://alpaca.markets/dashboard
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# TradersPost webhook URL — create one at https://traderspost.io
TRADERSPOST_STOCKS_WEBHOOK_URL=https://traderspost.io/trading/webhook/your-webhook-id

# Data feed: iex (free tier) or sip (requires subscription)
ALPACA_DATA_FEED=iex
